<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Emerald.Core</RootNamespace>
    <AssemblyName>Emerald.Core</AssemblyName>
    <!-- TimecodeMask is a WPF attached behaviour: every module that types a timecode into a
         TextBox shares it, so it lives here rather than in whichever module needed it first. -->
    <UseWPF>true</UseWPF>
    <!-- VideoMasterHD.dll in System32 is 64-bit, so every assembly in the process must be. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- The log database. Core rather than App so every module's record, and the remote monitor,
       reach it. The same SQLite build the Ingest database already ships, without EF. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Emerald.Edl</RootNamespace>
    <AssemblyName>Emerald.EDL</AssemblyName>
    <!-- VideoMasterHD.dll in System32 is 64-bit, so every assembly in the process must be. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Emerald.Core\Emerald.Core.csproj" />
    <ProjectReference Include="..\Emerald.Deltacast\Emerald.Deltacast.csproj" />
    <ProjectReference Include="..\Emerald.Video\Emerald.Video.csproj" />
    <ProjectReference Include="..\Emerald.Media\Emerald.Media.csproj" />
  </ItemGroup>
</Project>

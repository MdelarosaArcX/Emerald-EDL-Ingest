<Window x:Class="Emerald.Ingest.IngestHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingest History" Height="620" Width="900" MinHeight="420" MinWidth="700"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="INGEST HISTORY" Foreground="{StaticResource Text}"
                               FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Hint}" Text="-"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Height="26" Padding="12,0" FontSize="11" Click="Refresh_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <TextBlock x:Name="EmptyText" Foreground="#5C6474" FontSize="12" VerticalAlignment="Top"
                           Text="No ingest has finished yet."/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#151A21" CornerRadius="4" Padding="10,7" Margin="0,0,0,5"
                                        BorderThickness="1" BorderBrush="{Binding Accent}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontFamily="Consolas" FontSize="12"
                                                       Foreground="{Binding Accent}">
                                                <Run Text="{Binding Status, Mode=OneWay}"/>
                                                <Run Text="   "/>
                                                <Run Text="{Binding ClipName, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Timing}" FontFamily="Consolas" FontSize="11"
                                                       Foreground="#8A93A3" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="11"
                                                       Foreground="#6B7382" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding When}" FontFamily="Consolas"
                                                   FontSize="11" Foreground="#6B7382"
                                                   VerticalAlignment="Top" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="Emerald.Ingest.IngestControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Emerald.Core;assembly=Emerald.Core"
        Title="Ingest Controller" Height="1010" Width="1180" MinHeight="760" MinWidth="1000"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: identity + realtime timecode. Same shape as the EDL Generator, because
             an operator moving between the two should not have to re-learn where the clock is. -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="INGEST CONTROLLER" Foreground="{StaticResource Text}"
                               FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="ApiInfoText" Text="VideoMaster SDK -" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="MockBanner" Style="{StaticResource Hint}" Visibility="Collapsed"
                               Foreground="{StaticResource Warn}" FontWeight="SemiBold"
                               Text="MOCK MODE - boards and recordings are simulated. Nothing is recorded from a card."/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="REALTIME TIMECODE" Foreground="{StaticResource Muted}"
                               FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TcDisplay" Text="--:--:--:--" FontFamily="Consolas"
                               FontSize="42" FontWeight="Bold" Foreground="{StaticResource Tc}"
                               HorizontalAlignment="Right" Margin="0,-2,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <Ellipse x:Name="TcDot" Width="8" Height="8" Fill="{StaticResource Muted}"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TcStatusText" Text="connecting..." Foreground="{StaticResource Muted}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="400"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================ left: the ingest job being built -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="INGEST SETTINGS" Style="{StaticResource SectionHeader}" Margin="0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ToggleButton x:Name="SimulateToggle" Content="SIMULATE"
                                                  Style="{StaticResource IpDeckTab}" Height="22"
                                                  Padding="10,0" FontSize="10.5"
                                                  Checked="Simulate_Changed" Unchecked="Simulate_Changed"
                                                  ToolTip="Run against simulated boards and a simulated recorder, for working without a card"/>
                                    <Button x:Name="RescanButton" Content="Rescan"
                                            Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                            Height="22" Padding="10,0" FontSize="11" Click="Rescan_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Board" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="BoardCombo" Tag="no board detected"
                                              SelectionChanged="BoardCombo_SelectionChanged"/>
                                    <TextBlock x:Name="BoardInfoText" Style="{StaticResource Hint}" Text="Scanning..."/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="PortCombo" Tag="no RX channel"
                                              SelectionChanged="Field_SelectionChanged"/>
                                    <TextBlock x:Name="PortInfoText" Style="{StaticResource Hint}" Text="-"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="BoardError" Style="{StaticResource Hint}"
                                       Foreground="{StaticResource Bad}" Visibility="Collapsed"/>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,16"/>

                            <TextBlock Text="TIMECODE GENERATOR" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ApiUrlBox" Grid.Column="0"/>
                                <Button x:Name="ApplyApiButton" Grid.Column="1" Content="Apply"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="ApplyApi_Click"/>
                            </Grid>
                            <TextBlock x:Name="ApiHint" Style="{StaticResource Hint}"
                                       Text="One address for all of Emerald - the deck, the EDL Generator and this module read the same clock."/>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,16"/>

                            <TextBlock Text="TIMING" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="Timecode (Start)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ReferenceBox" Grid.Column="0" Text="00:00:00:00"
                                         FontFamily="Consolas" FontSize="15"
                                         core:TimecodeMask.Enabled="True" TextChanged="Reference_Changed"/>
                                <Button x:Name="NowButton" Grid.Column="1" Content="NOW"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="Now_Click"
                                        ToolTip="Copy the realtime timecode into this field"/>
                            </Grid>
                            <TextBlock x:Name="ReferenceError" Style="{StaticResource Hint}"
                                       Foreground="{StaticResource Bad}" Visibility="Collapsed"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The recorder rolls exactly here, with no preroll. HH:MM:SS:FF - type digits only."/>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SOM (media start timecode)" Style="{StaticResource FieldLabel}"
                                               ToolTip="The timecode written into the head of the recorded file"/>
                                    <TextBox x:Name="SomBox" FontFamily="Consolas" FontSize="15"
                                             core:TimecodeMask.Enabled="True" TextChanged="Som_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="EOM (End of Message)" Style="{StaticResource FieldLabel}"
                                               ToolTip="Start timecode + Duration - when the recording stops"/>
                                    <TextBox x:Name="EomBox" FontFamily="Consolas" FontSize="15"
                                             core:TimecodeMask.Enabled="True" TextChanged="Eom_Changed"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="SomEomError" Style="{StaticResource Hint}"
                                       Foreground="{StaticResource Bad}" Visibility="Collapsed"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Duration" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="DurationBox" FontFamily="Consolas" FontSize="15"
                                             core:TimecodeMask.Enabled="True" TextChanged="Duration_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Media TC at end of clip" Style="{StaticResource FieldLabel}"
                                               ToolTip="SOM + Duration - what the file reads at its last frame"/>
                                    <TextBox x:Name="MediaEndBox" FontFamily="Consolas" FontSize="15"
                                             IsReadOnly="True" IsTabStop="False" Focusable="False"
                                             Foreground="{StaticResource Tc}" Text="00:00:00:00"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="DurationError" Style="{StaticResource Hint}"
                                       Foreground="{StaticResource Bad}" Visibility="Collapsed"/>
                            <TextBlock x:Name="TimingHint" Style="{StaticResource Hint}"
                                       Text="Edit either one - Duration and EOM follow each other. The recording runs from the actual start to EOM."/>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,16"/>

                            <TextBlock Text="CLIP" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="Clip Name" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ClipNameBox" Grid.Column="0" FontFamily="Consolas"
                                         TextChanged="Field_Changed"/>
                                <Button x:Name="RegenerateNameButton" Grid.Column="1" Content="Regenerate"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="RegenerateName_Click"
                                        ToolTip="Generate a fresh name from the date and the clock"/>
                            </Grid>
                            <TextBlock x:Name="ClipNameError" Style="{StaticResource Hint}"
                                       Foreground="{StaticResource Bad}" Visibility="Collapsed"/>

                            <Grid Margin="0,14,0,5">
                                <TextBlock Text="Ingest Metadata" Style="{StaticResource FieldLabel}" Margin="0"/>
                                <TextBlock x:Name="MetadataCount" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Right" Margin="0" Text="0"/>
                            </Grid>
                            <TextBox x:Name="MetadataBox" Height="86" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" FontSize="12.5"
                                     TextChanged="Metadata_Changed"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Free-form. Stored with the ingest record, not written into the file."/>

                            <TextBlock Text="Directory" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DirectoryBox" Grid.Column="0" TextChanged="Field_Changed"/>
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..."
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="Browse_Click"/>
                            </Grid>
                            <TextBlock x:Name="DirectoryHint" Style="{StaticResource Hint}" Text="-"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <Button x:Name="StartButton" Content="START INGEST" Style="{StaticResource PrimaryButton}"
                                Click="StartIngest_Click" ToolTip="Queue this ingest job"/>
                        <TextBlock x:Name="StartStatusText" Style="{StaticResource Hint}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================ right: what the job will do -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="INGEST STATUS" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse x:Name="ReadyDot" Width="9" Height="9" Fill="{StaticResource Muted}"
                                     VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="ReadyText" Text="Checking..." Foreground="{StaticResource Muted}"
                                       FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="76"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Board" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="StatusBoardText" Grid.Row="0" Grid.Column="1" Text="-"
                                       Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="StatusPortText" Grid.Row="1" Grid.Column="1" Text="-"
                                       Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="StatusStateText" Grid.Row="2" Grid.Column="1" Text="IDLE"
                                       Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,16"/>

                        <TextBlock Text="SCHEDULE PREVIEW" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start Timecode"
                                       Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PreviewReference" Grid.Row="0" Grid.Column="1" Text="--:--:--:--"
                                       FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Text}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Recording rolls"
                                       Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PreviewActualStart" Grid.Row="1" Grid.Column="1" Text="--:--:--:--"
                                       FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Tc}"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="EOM"
                                       Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PreviewEom" Grid.Row="2" Grid.Column="1" Text="--:--:--:--"
                                       FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Text}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration"
                                       Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PreviewDuration" Grid.Row="3" Grid.Column="1" Text="--:--:--:--"
                                       FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Text}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Media TC starts"
                                       Foreground="{StaticResource Muted}" FontSize="11.5"/>
                            <TextBlock x:Name="PreviewMediaStart" Grid.Row="4" Grid.Column="1" Text="--:--:--:--"
                                       FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Muted}"/>
                        </Grid>

                        <TextBlock x:Name="PreviewNote" Style="{StaticResource Hint}"
                                   Text="Recording rolls on the start timecode and stops at EOM. SOM is the timecode written into the file."/>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,16"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="RECENT INGESTS" Style="{StaticResource SectionHeader}" Margin="0"/>
                            <Button x:Name="ViewAllButton" Content="View All" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" Height="22" Padding="10,0" FontSize="11"
                                    Click="ViewAll_Click"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="RecentEmptyText" Grid.Row="1" Foreground="#5C6474" FontSize="12"
                               Text="Nothing ingested yet."/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RecentList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#151A21" CornerRadius="4" Padding="9,6" Margin="0,0,0,4"
                                            BorderThickness="1" BorderBrush="{Binding Accent}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileName}" FontFamily="Consolas"
                                                           FontSize="11.5" Foreground="{Binding Accent}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Timing}" FontFamily="Consolas"
                                                           FontSize="11" Foreground="#8A93A3" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Size}" FontFamily="Consolas"
                                                       FontSize="11" Foreground="#6B7382"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================ bottom: activity + queue -->
        <Grid Grid.Row="2" Margin="0,14,0,0" Height="212">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="400"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="ACTIVITY LOG" Style="{StaticResource SectionHeader}" Margin="0"/>
                        <Button x:Name="ClearLogButton" Content="Clear" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Height="22" Padding="10,0" FontSize="11"
                                Click="ClearLog_Click"/>
                    </Grid>

                    <ScrollViewer x:Name="LogScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas"
                                                   FontSize="11.5" Foreground="#5C6474" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" FontFamily="Consolas"
                                                   FontSize="11.5" Foreground="{Binding Brush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="QueueHeader" Text="INGEST QUEUE" Style="{StaticResource SectionHeader}"
                                   Margin="0"/>
                        <Button x:Name="ClearFinishedButton" Content="Clear finished"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Height="22" Padding="10,0" FontSize="11" Click="ClearFinished_Click"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="QueueEmptyText" Foreground="#5C6474" FontSize="12"
                                   VerticalAlignment="Top"
                                   Text="Nothing queued. START INGEST adds a job here."/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="QueueList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#151A21" CornerRadius="4" Padding="9,6" Margin="0,0,0,4"
                                                BorderThickness="1" BorderBrush="{Binding Accent}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Position}"
                                                           FontFamily="Consolas" FontSize="11.5"
                                                           Foreground="#6B7382" VerticalAlignment="Top"
                                                           Margin="0,0,10,0"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontFamily="Consolas" FontSize="11.5"
                                                               Foreground="{Binding Accent}">
                                                        <Run Text="{Binding StartTimecode, Mode=OneWay}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding ClipName, Mode=OneWay}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding Status, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Detail}" FontFamily="Consolas"
                                                               FontSize="11" Foreground="#8A93A3"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Top" Margin="8,0,0,0">
                                                    <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                                            Height="22" Padding="8,0" FontSize="10.5"
                                                            Foreground="{StaticResource Warn}"
                                                            Visibility="{Binding CancelVisibility}"
                                                            Click="CancelJob_Click"/>
                                                    <Button Content="Remove" Style="{StaticResource GhostButton}"
                                                            Height="22" Padding="8,0" FontSize="10.5"
                                                            Visibility="{Binding RemoveVisibility}"
                                                            Click="RemoveJob_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

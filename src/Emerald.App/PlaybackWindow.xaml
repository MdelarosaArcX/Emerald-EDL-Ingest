<Window x:Class="Emerald.App.PlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emerald Playback"
        ResizeMode="CanResize" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource IpBg}" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- Laid out once at the size below and scaled by the Viewbox, exactly as the capture
         deck is, so the two read as the same application at any window size. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1060" Height="790">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================= header ============================= -->
            <Grid Grid.Row="0" Margin="18,0,18,0">
                <TextBlock Text="Emerald Playback" Foreground="{StaticResource IpMint}"
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" Text="--:--:--:--" FontFamily="Consolas"
                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource IpText}"
                               VerticalAlignment="Center"/>
                    <Ellipse x:Name="ClockDot" Width="8" Height="8" Margin="9,0,0,0"
                             Fill="{StaticResource IpDim}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ============================== body ============================== -->
            <Grid Grid.Row="1" Margin="18,0,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ====================== media, on the left ====================== -->
                <Border Grid.Column="0" Background="{StaticResource IpPanel}"
                        BorderBrush="{StaticResource IpLine}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- The clip being auditioned before it goes out. -->
                        <Border Grid.Row="0" Background="{StaticResource IpStage}" CornerRadius="6,6,0,0"
                                Margin="3,3,3,0" ClipToBounds="True">
                            <Grid>
                                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="Uniform" ScrubbingEnabled="True"
                                              MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                                              MediaFailed="Player_MediaFailed"/>

                                <TextBlock x:Name="StagePlaceholder" Text="no clip selected"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource IpDim}" FontSize="12.5"/>

                                <!-- Tidal lock takes the whole stage while it is running: it is
                                     the thing an operator is watching, and the countdown has to
                                     be readable across the room. -->
                                <Border x:Name="LockPanel" Visibility="Collapsed"
                                        Background="#E6060A10" CornerRadius="6">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="LockHeadline" Text="TIDAL LOCK"
                                                   Foreground="{StaticResource IpMuted}" FontSize="12"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="CountdownText" Text="01:00" FontFamily="Consolas"
                                                   FontSize="76" FontWeight="Bold"
                                                   Foreground="{StaticResource IpMint}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="CountdownDetail" Text=""
                                                   Foreground="{StaticResource IpDim}" FontSize="11.5"
                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap" MaxWidth="420"/>
                                    </StackPanel>
                                </Border>

                                <!-- On-air state, over the picture where it cannot be missed. -->
                                <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                        Margin="10" Background="#CC060A10" CornerRadius="3" Padding="10,5"
                                        BorderThickness="1" BorderBrush="{StaticResource IpLine}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="AirDot" Width="9" Height="9"
                                                 Fill="{StaticResource IpDim}" VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock x:Name="AirText" Text="TX idle" FontSize="11"
                                                   Foreground="{StaticResource IpMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Transport for the audition, and the way on to air. -->
                        <Grid Grid.Row="1" Margin="9,7,9,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IpIconButton}" Width="26" Height="22"
                                        Tag="{StaticResource IconPlay}" Click="PlayPause_Click"
                                        ToolTip="Play or pause the audition"/>
                                <Button Style="{StaticResource IpIconButton}" Width="26" Height="22"
                                        Tag="{StaticResource IconStop}" Click="StopAudition_Click"
                                        ToolTip="Stop the audition"/>
                                <TextBlock x:Name="ClipNameText" Text="-" Foreground="{StaticResource IpMuted}"
                                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IpIconButton}" Width="24" Height="22"
                                        Tag="{StaticResource IconRefresh}" Click="RefreshClips_Click"
                                        ToolTip="Re-read the store"/>
                                <Button x:Name="PlayToTxButton" Content="PLAY TO TX" Margin="8,0,0,0"
                                        Style="{StaticResource GhostButton}" Height="24" Padding="14,0"
                                        FontSize="11" FontWeight="SemiBold"
                                        Foreground="{StaticResource IpMint}"
                                        Click="PlayToTx_Click"
                                        ToolTip="Put the selected clip on the transmitter now"/>
                            </StackPanel>
                        </Grid>

                        <!-- Clip strip -->
                        <Grid Grid.Row="2" Height="226" Margin="9,0,9,9">
                            <ListBox x:Name="ClipStrip" Style="{StaticResource IpClipStrip}"
                                     SelectionChanged="ClipStrip_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="70"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="#070B11" CornerRadius="3,3,0,0"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Path Data="{StaticResource IconFilm}" Fill="#22303F"
                                                          Stretch="Uniform" Width="26" Height="26"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="7,5,7,6">
                                                <TextBlock Text="{Binding Display}" Foreground="{StaticResource IpText}"
                                                           FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding Stamp}" Foreground="{StaticResource IpDim}"
                                                           FontSize="9.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="StripEmpty" Text="the capture store is empty"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource IpDim}" FontSize="11.5"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ================= playback deck, on the right ================= -->
                <ScrollViewer Grid.Column="2" Width="352"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Confidence monitor on the return feed, same size as the capture
                             deck's so the two rooms match. -->
                        <Border Background="{StaticResource IpStage}" BorderBrush="{StaticResource IpTeal}"
                                BorderThickness="1.5" CornerRadius="4" Height="196">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="1"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="PreviewPlaceholder" Text="preview idle"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource IpDim}" FontSize="11.5"/>
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="7"
                                        Background="#CC060A10" CornerRadius="3" Padding="7,3">
                                    <TextBlock x:Name="PreviewStatus" Text="preview idle"
                                               Foreground="{StaticResource IpMuted}" FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ============ transmit ============ -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,7,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="Transmit" Style="{StaticResource IpCardTitle}"/>
                                    <Button Content="Rescan" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" Height="20" Padding="9,0"
                                            FontSize="10.5" Click="Rescan_Click"/>
                                </Grid>

                                <TextBlock Text="Board" Style="{StaticResource IpLabel}"/>
                                <ComboBox x:Name="TxBoardBox" Style="{StaticResource IpMiniCombo}"
                                          Tag="no board detected" SelectionChanged="TxBoard_Changed"/>

                                <TextBlock Text="TX port" Style="{StaticResource IpLabel}" Margin="0,8,0,3"/>
                                <ComboBox x:Name="TxPortBox" Style="{StaticResource IpMiniCombo}"
                                          Tag="no TX channel" SelectionChanged="Field_Changed"/>

                                <TextBlock x:Name="TxInfoText" Text="-" Foreground="{StaticResource IpDim}"
                                           FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ============ preview ============ -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,7,0,0">
                            <StackPanel>
                                <TextBlock Text="Preview" Style="{StaticResource IpCardTitle}" Margin="0,0,0,9"/>

                                <TextBlock Text="Board" Style="{StaticResource IpLabel}"/>
                                <ComboBox x:Name="PreviewBoardBox" Style="{StaticResource IpMiniCombo}"
                                          Tag="no board detected" SelectionChanged="PreviewBoard_Changed"/>

                                <TextBlock Text="RX port" Style="{StaticResource IpLabel}" Margin="0,8,0,3"/>
                                <ComboBox x:Name="PreviewPortBox" Style="{StaticResource IpMiniCombo}"
                                          Tag="no RX channel" SelectionChanged="PreviewPort_Changed"/>

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Start" Style="{StaticResource GhostButton}"
                                            Height="26" FontSize="11" Padding="0" Click="StartPreview_Click"/>
                                    <Button Grid.Column="2" Content="Stop" Style="{StaticResource GhostButton}"
                                            Height="26" FontSize="11" Padding="0" Click="StopPreview_Click"/>
                                </Grid>

                                <TextBlock x:Name="PreviewInfoText" Text="-" Foreground="{StaticResource IpDim}"
                                           FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ============ tidal lock ============ -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,7,0,0">
                            <StackPanel>
                                <TextBlock Text="Tidal Lock" Style="{StaticResource IpCardTitle}" Margin="0,0,0,7"/>

                                <!-- Spelled out as steps, because the second one happens in the
                                     other window and arming on its own transmits nothing. -->
                                <TextBlock x:Name="Step1Text" Text="1.  Arm, below"
                                           Foreground="{StaticResource IpMuted}" FontSize="10.5"/>
                                <TextBlock x:Name="Step2Text" Text="2.  Press Record on the capture deck"
                                           Foreground="{StaticResource IpMuted}" FontSize="10.5" Margin="0,3,0,0"/>
                                <TextBlock x:Name="Step3Text" Text="3.  On air one minute later"
                                           Foreground="{StaticResource IpMuted}" FontSize="10.5" Margin="0,3,0,9"/>

                                <TextBlock Text="Delay" Style="{StaticResource IpLabel}"/>
                                <ComboBox x:Name="DelayBox" Style="{StaticResource IpMiniCombo}"
                                          SelectionChanged="Field_Changed"/>

                                <Button x:Name="ArmButton" Content="ARM TIDAL LOCK" Margin="0,10,0,0"
                                        Style="{StaticResource PrimaryButton}" Height="34" FontSize="12"
                                        Click="Arm_Click"/>

                                <Border Background="{StaticResource IpInput}" BorderBrush="{StaticResource IpLine}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,9,0,0" Padding="10,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="LockDot" Width="9" Height="9"
                                                     Fill="{StaticResource IpDim}" VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                            <TextBlock x:Name="LockStateText" Text="OFF" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource IpMuted}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LockDetailText" Text="Not in use."
                                                   Foreground="{StaticResource IpDim}" FontSize="10"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ============ output ============ -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,7,0,0">
                            <StackPanel>
                                <TextBlock Text="Output" Style="{StaticResource IpCardTitle}" Margin="0,0,0,7"/>

                                <TextBlock x:Name="OutputStateText" Text="Idle." Foreground="{StaticResource IpMuted}"
                                           FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock x:Name="OutputDetailText" Text="" Foreground="{StaticResource IpDim}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <Button x:Name="StopOutputButton" Content="STOP OUTPUT" Margin="0,10,0,0"
                                        Style="{StaticResource GhostButton}" Height="30"
                                        Foreground="{StaticResource IpRed}" FontWeight="SemiBold"
                                        IsEnabled="False" Click="StopOutput_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- ============ activity ============ -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,7,0,0">
                            <Grid Height="150">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="Activity" Style="{StaticResource IpCardTitle}"/>
                                    <Button Content="Clear" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" Height="20" Padding="9,0"
                                            FontSize="10.5" Click="ClearLog_Click"/>
                                </Grid>

                                <ScrollViewer x:Name="LogScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LogList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                               FontFamily="Consolas" FontSize="10"
                                                               Foreground="{StaticResource IpDim}" Margin="0,0,7,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                               FontFamily="Consolas" FontSize="10"
                                                               Foreground="{Binding Brush}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Viewbox>
</Window>

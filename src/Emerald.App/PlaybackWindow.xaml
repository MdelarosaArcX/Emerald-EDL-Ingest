<Window x:Class="Emerald.App.PlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emerald Playback"
        ResizeMode="CanResize" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource IpBg}" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- Laid out once at the size below and scaled by the Viewbox, exactly as the capture
         deck is, so the two read as the same application at any window size. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1060" Height="790">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================= header ============================= -->
            <Grid Grid.Row="0" Margin="18,0,18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/emerald-mark.png" Width="26" Height="26" Margin="0,0,9,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="Emerald Playback" Foreground="{StaticResource IpMint}"
                               FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" Text="--:--:--:--" FontFamily="Consolas"
                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource IpText}"
                               VerticalAlignment="Center"/>
                    <Ellipse x:Name="ClockDot" Width="8" Height="8" Margin="9,0,0,0"
                             Fill="{StaticResource IpDim}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ============================== body ============================== -->
            <Grid Grid.Row="1" Margin="18,0,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ====================== the record, on the left ======================
                     This deck used to audition clips on a large stage with a strip of them
                     underneath. Nothing about that was what an operator watches here: the
                     transmitter carries the delayed receiver, not a clip chosen by hand, and
                     what they need is what it is doing and what it has done. So the stage is
                     the log, and the two things worth seeing across a room - whether it is on
                     air, and how much of the delay is left - sit above it. -->
                <Border Grid.Column="0" Background="{StaticResource IpPanel}"
                        BorderBrush="{StaticResource IpLine}" BorderThickness="1" CornerRadius="7">
                    <Grid Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- On air, and the countdown while the delay fills. -->
                        <Border Grid.Row="0" Background="{StaticResource IpStage}" CornerRadius="5"
                                Padding="14,11" Margin="0,0,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse x:Name="AirDot" Width="11" Height="11"
                                             Fill="{StaticResource IpDim}" VerticalAlignment="Center"
                                             Margin="0,0,9,0"/>
                                    <TextBlock x:Name="AirText" Text="TX idle" FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource IpMuted}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LockHeadline" Text="TIDAL LOCK"
                                               Foreground="{StaticResource IpMuted}" FontSize="10"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CountdownDetail" Text=""
                                               Foreground="{StaticResource IpDim}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Kept named and in the tree so the countdown still has somewhere
                                     to go. It is a panel in name only now; the number is the part
                                     that mattered. -->
                                <Border x:Name="LockPanel" Grid.Column="2" Visibility="Collapsed"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="CountdownText" Text="01:00" FontFamily="Consolas"
                                               FontSize="40" FontWeight="Bold"
                                               Foreground="{StaticResource IpMint}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Frames out against frames recorded. The question an operator asks of a
                             delay is whether it is still keeping up, and that is a number. -->
                        <Border Grid.Row="1" Background="{StaticResource IpStage}" CornerRadius="5"
                                Padding="14,9" Margin="0,0,0,7">
                            <Grid>
                                <TextBlock Text="ON AIR FRAMES" Foreground="{StaticResource IpMuted}"
                                           FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AirFramesText" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" FontFamily="Consolas"
                                           FontSize="12.5" Foreground="{StaticResource IpTeal}"
                                           Text="-"/>
                            </Grid>
                        </Border>

                        <!-- The log itself, which is now the point of this side of the page. -->
                        <Border Grid.Row="2" Background="{StaticResource IpStage}" CornerRadius="5"
                                Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="LogHeader" Grid.Column="0" Text="PLAYBACK ACTIVITY"
                                               Foreground="{StaticResource IpMuted}"
                                               FontSize="9.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <!-- What is on air, while tidal lock is transmitting: the timecode the
                                         picture going out was captured at, and how far into the recording
                                         it is. The same figure Live Edit's on-air mark is drawn from. -->
                                    <StackPanel x:Name="AirTcPanel" Grid.Column="1" Orientation="Horizontal"
                                                Visibility="Collapsed" VerticalAlignment="Center" Margin="16,0,12,0"
                                                ToolTip="Timecode of the frame on air (when it was captured), and how far into the recording it is">
                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{StaticResource IpRed}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="ON AIR" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource IpRed}" VerticalAlignment="Center"
                                                   Margin="0,0,7,0"/>
                                        <TextBlock x:Name="AirTcText" Text="--:--:--:--" FontFamily="Consolas"
                                                   FontSize="13" FontWeight="Bold" Foreground="{StaticResource IpRed}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AirElapsedText" Text="" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{StaticResource IpMuted}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ToggleButton x:Name="FollowLogButton" Content="FOLLOW"
                                                      IsChecked="True"
                                                      Style="{StaticResource IpSmallToggle}"
                                                      Height="20" Padding="9,0" FontSize="9.5"
                                                      ToolTip="Keep the newest line in view"/>
                                        <Button Content="Clear" Style="{StaticResource GhostButton}"
                                                Margin="6,0,0,0" Height="20" Padding="9,0"
                                                FontSize="10.5" Click="ClearLog_Click"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer x:Name="LogScroller" Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LogList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                               FontFamily="Consolas" FontSize="10.5"
                                                               Foreground="{StaticResource IpDim}"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Source}"
                                                               FontFamily="Consolas" FontSize="9"
                                                               Foreground="{StaticResource IpDim}"
                                                               Width="62"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                               FontFamily="Consolas" FontSize="10.5"
                                                               Foreground="{Binding Brush}"
                                                               TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= playback deck, on the right ================= -->
                <ScrollViewer Grid.Column="2" Width="352"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Confidence monitor on the return feed, same size as the capture
                             deck's so the two rooms match. -->
                        <Border Background="{StaticResource IpStage}" BorderBrush="{StaticResource IpTeal}"
                                BorderThickness="1.5" CornerRadius="4" Height="196">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="1"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <!-- The logo, while there is no picture: shown and hidden with the
                                     placeholder line, so it is never over a live feed. -->
                                <Image Source="/Assets/emerald-logo.png" Height="104" Opacity="0.6"
                                       Margin="0,0,0,26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding Visibility, ElementName=PreviewPlaceholder}"/>
                                <TextBlock x:Name="PreviewPlaceholder" Text="preview idle"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           Margin="0,0,0,16"
                                           Foreground="{StaticResource IpDim}" FontSize="11.5"/>
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="7"
                                        Background="#CC060A10" CornerRadius="3" Padding="7,3">
                                    <TextBlock x:Name="PreviewStatus" Text="preview idle"
                                               Foreground="{StaticResource IpMuted}" FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ============ transmit ============ -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,7,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="Transmit" Style="{StaticResource IpCardTitle}"/>
                                    <Button Content="Rescan" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" Height="20" Padding="9,0"
                                            FontSize="10.5" Click="Rescan_Click"/>
                                </Grid>

                                <TextBlock Text="Board" Style="{StaticResource IpLabel}"/>
                                <ComboBox x:Name="TxBoardBox" Style="{StaticResource IpMiniCombo}"
                                          Tag="no board detected" SelectionChanged="TxBoard_Changed"/>

                                <!-- Every TX port the board has, each switched on or off.
                                     More than one is the ordinary case: a transmitter and a
                                     monitoring chain want the same delayed picture, and there is
                                     one read of it per frame either way. -->
                                <TextBlock Text="TX ports" Style="{StaticResource IpLabel}" Margin="0,8,0,3"/>

                                <ItemsControl x:Name="TxPortList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3" ToolTip="{Binding Hint}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- The port, then ON or OFF. The toggle says which
                                                     it is rather than only looking pressed. -->
                                                <TextBlock Grid.Column="0" Text="{Binding ToggleText}"
                                                           VerticalAlignment="Center" Width="38"
                                                           FontFamily="Consolas" FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource IpText}"/>

                                                <ToggleButton Grid.Column="1" Width="46" Height="22"
                                                              HorizontalAlignment="Left"
                                                              Style="{StaticResource IpSmallToggle}"
                                                              FontSize="9.5" Padding="0"
                                                              Content="{Binding OnOffText}"
                                                              IsChecked="{Binding On, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanToggle}"
                                                              Click="TxPort_Toggled"/>

                                                <TextBlock Grid.Column="2" Text="{Binding StateText}"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas" FontSize="8.5"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding StateBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="TxPortsEmpty" FontSize="9.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource IpDim}"
                                           Text="No TX ports on this board."/>

                                <TextBlock x:Name="TxInfoText" Text="-" Foreground="{StaticResource IpDim}"
                                           FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ============ preview ============ -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,7,0,0">
                            <StackPanel>
                                <TextBlock Text="Preview" Style="{StaticResource IpCardTitle}" Margin="0,0,0,9"/>

                                <TextBlock Text="Board" Style="{StaticResource IpLabel}"/>
                                <ComboBox x:Name="PreviewBoardBox" Style="{StaticResource IpMiniCombo}"
                                          Tag="no board detected" SelectionChanged="PreviewBoard_Changed"/>

                                <TextBlock Text="RX port" Style="{StaticResource IpLabel}" Margin="0,8,0,3"/>
                                <ComboBox x:Name="PreviewPortBox" Style="{StaticResource IpMiniCombo}"
                                          Tag="no RX channel" SelectionChanged="PreviewPort_Changed"/>

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Start" Style="{StaticResource GhostButton}"
                                            Height="26" FontSize="11" Padding="0" Click="StartPreview_Click"/>
                                    <Button Grid.Column="2" Content="Stop" Style="{StaticResource GhostButton}"
                                            Height="26" FontSize="11" Padding="0" Click="StopPreview_Click"/>
                                </Grid>

                                <TextBlock x:Name="PreviewInfoText" Text="-" Foreground="{StaticResource IpDim}"
                                           FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ============ tidal lock ============ -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,7,0,0">
                            <StackPanel>
                                <TextBlock Text="Tidal Lock" Style="{StaticResource IpCardTitle}" Margin="0,0,0,7"/>

                                <!-- Spelled out as steps, because the second one happens in the
                                     other window and arming on its own transmits nothing. -->
                                <TextBlock x:Name="Step1Text" Text="1.  Arm, below"
                                           Foreground="{StaticResource IpMuted}" FontSize="10.5"/>
                                <TextBlock x:Name="Step2Text" Text="2.  Press Record on the capture deck"
                                           Foreground="{StaticResource IpMuted}" FontSize="10.5" Margin="0,3,0,0"/>
                                <TextBlock x:Name="Step3Text" Text="3.  On air one minute later"
                                           Foreground="{StaticResource IpMuted}" FontSize="10.5" Margin="0,3,0,9"/>

                                <TextBlock Text="Delay" Style="{StaticResource IpLabel}"/>
                                <ComboBox x:Name="DelayBox" Style="{StaticResource IpMiniCombo}"
                                          SelectionChanged="Field_Changed"/>

                                <Button x:Name="ArmButton" Content="ARM TIDAL LOCK" Margin="0,10,0,0"
                                        Style="{StaticResource PrimaryButton}" Height="34" FontSize="12"
                                        Click="Arm_Click"/>

                                <Border Background="{StaticResource IpInput}" BorderBrush="{StaticResource IpLine}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,9,0,0" Padding="10,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="LockDot" Width="9" Height="9"
                                                     Fill="{StaticResource IpDim}" VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                            <TextBlock x:Name="LockStateText" Text="OFF" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource IpMuted}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LockDetailText" Text="Not in use."
                                                   Foreground="{StaticResource IpDim}" FontSize="10"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ============ output ============ -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,7,0,0">
                            <StackPanel>
                                <TextBlock Text="Output" Style="{StaticResource IpCardTitle}" Margin="0,0,0,7"/>

                                <TextBlock x:Name="OutputStateText" Text="Idle." Foreground="{StaticResource IpMuted}"
                                           FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock x:Name="OutputDetailText" Text="" Foreground="{StaticResource IpDim}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <Button x:Name="StopOutputButton" Content="STOP OUTPUT" Margin="0,10,0,0"
                                        Style="{StaticResource GhostButton}" Height="30"
                                        Foreground="{StaticResource IpRed}" FontWeight="SemiBold"
                                        IsEnabled="False" Click="StopOutput_Click"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Viewbox>
</Window>

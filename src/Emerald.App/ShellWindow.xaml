<Window x:Class="Emerald.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Emerald.Core;assembly=Emerald.Core"
        Title="Emerald IP"
        ResizeMode="CanResize" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource IpBg}" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- The deck is laid out once, at the size below, and the Viewbox scales that whole
         design to whatever size the window is dragged to. Every column, meter and thumbnail
         is measured against this box, so the parts keep their proportions to each other
         instead of each being re-fitted to a window that moves under them. -->
    <Viewbox x:Name="Scaler" Stretch="Uniform">
        <Grid Width="1060" Height="790">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================ header ============================ -->
            <Grid Grid.Row="0" Margin="20,0,18,0">
                <TextBlock Text="Emerald IP" Foreground="{StaticResource IpMint}"
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="0,4,0,0">
                    <Button Content="Capture" Style="{StaticResource IpNavActive}"
                            ToolTip="This deck"/>
                    <Button Content="Playback" Style="{StaticResource IpNav}"
                            Click="Playback_Click" ToolTip="Open Live Edit"/>
                    <Button Content="Logging" Style="{StaticResource IpNav}"
                            Click="Logging_Click" ToolTip="Open the EDL Generator and its activity log"/>
                    <Button Content="Ingest" Style="{StaticResource IpNav}"
                            Click="Ingest_Click" ToolTip="Open the Ingest Controller"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" Text="--:--:--:--" FontFamily="Consolas"
                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource IpText}"
                               VerticalAlignment="Center"
                               ToolTip="Master timecode, locked to the timecode API"/>

                    <Button x:Name="LinkButton" Style="{StaticResource IpIconButton}" Margin="26,0,0,0"
                            Foreground="{StaticResource IpMint}" Click="Link_Click">
                        <Button.Tag>
                            <PathGeometry Figures="M8,12 A2,2 0 1,0 8.01,12 Z M4.4,9.6 A5,5 0 0,1 11.6,9.6 L10.2,8.2 A3,3 0 0,0 5.8,8.2 Z M1.8,7 A8.7,8.7 0 0,1 14.2,7 L12.8,5.6 A6.7,6.7 0 0,0 3.2,5.6 Z"/>
                        </Button.Tag>
                    </Button>

                    <Button x:Name="AccountButton" Style="{StaticResource IpIconButton}" Margin="4,0,0,0"
                            Foreground="{StaticResource IpMuted}" Click="SourceDeck_Click"
                            ToolTip="Boards and modules">
                        <Button.Tag>
                            <PathGeometry Figures="M8,0.6 A7.4,7.4 0 1,0 8.01,0.6 Z M8,2.4 A5.6,5.6 0 0,1 12.6,11.2 A6.4,6.4 0 0,0 3.4,11.2 A5.6,5.6 0 0,1 8,2.4 Z M8,4.2 A2.6,2.6 0 1,0 8.01,4.2 Z"/>
                        </Button.Tag>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================= body ============================= -->
            <Grid Grid.Row="1" Margin="0,0,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left handle: the boards, and the way through to the other modules. -->
                <ToggleButton x:Name="SourceDeckTab" Grid.Column="0" Content="Source Deck"
                              Style="{StaticResource IpDeckTab}" HorizontalAlignment="Left"
                              Margin="4,0,0,0" Checked="SourceDeck_Toggled" Unchecked="SourceDeck_Toggled"/>

                <!-- ============================ stage ============================ -->
                <Border Grid.Column="1" Background="{StaticResource IpPanel}"
                        BorderBrush="{StaticResource IpLine}" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Player -->
                        <Border Grid.Row="0" Background="{StaticResource IpStage}" CornerRadius="6,6,0,0"
                                Margin="3,3,3,0" ClipToBounds="True">
                            <Grid>
                                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="Uniform" ScrubbingEnabled="True"
                                              MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                                              MediaFailed="Player_MediaFailed"/>

                                <TextBlock x:Name="StagePlaceholder" Text="no clip selected"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource IpDim}" FontSize="12.5"/>

                                <!-- Clip metadata, over the foot of the picture -->
                                <Border x:Name="InfoOverlay" VerticalAlignment="Bottom" Background="#D9070C13"
                                        Padding="12,9,10,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Title"
                                                   Style="{StaticResource IpLabel}"/>
                                        <TextBlock x:Name="ClipTitleText" Grid.Row="0" Grid.Column="1" Text="-"
                                                   Style="{StaticResource IpValue}" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description"
                                                   Style="{StaticResource IpLabel}" Margin="0,5,8,0"/>
                                        <TextBlock x:Name="ClipDescriptionText" Grid.Row="1" Grid.Column="1"
                                                   Text="-" Style="{StaticResource IpValue}" Margin="0,5,0,0"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Duration | FPS"
                                                   Style="{StaticResource IpLabel}" Margin="0,5,8,0"/>
                                        <TextBlock x:Name="ClipDurationText" Grid.Row="2" Grid.Column="1"
                                                   Text="-" Style="{StaticResource IpValue}" Margin="0,5,0,0"/>

                                        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                                VerticalAlignment="Top" Width="18" Height="18"
                                                Style="{StaticResource IpIconButton}"
                                                Foreground="{StaticResource IpMuted}"
                                                Tag="{StaticResource IconClose}" Click="HideInfo_Click"
                                                ToolTip="Hide the clip details"/>
                                    </Grid>
                                </Border>

                                <!-- Scrub bar -->
                                <Grid x:Name="ScrubTrack" Height="5" VerticalAlignment="Bottom"
                                      Background="#16202C" Cursor="Hand"
                                      MouseLeftButtonDown="Scrub_MouseDown">
                                    <Border x:Name="ScrubFill" HorizontalAlignment="Left" Width="0"
                                            Background="{StaticResource IpBlue}"/>
                                    <Border x:Name="MarkInTick" HorizontalAlignment="Left" Width="2"
                                            Background="{StaticResource IpMint}" Visibility="Collapsed"/>
                                    <Border x:Name="MarkOutTick" HorizontalAlignment="Left" Width="2"
                                            Background="{StaticResource IpRed}" Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Transport -->
                        <UniformGrid Grid.Row="1" Rows="1" Columns="12" Margin="8,7,8,7">
                            <Button x:Name="PlayButton" Style="{StaticResource IpIconButton}"
                                    Tag="{StaticResource IconPlay}" Click="PlayPause_Click"
                                    ToolTip="Play / pause"/>
                            <Button Style="{StaticResource IpIconButton}" Tag="{StaticResource IconStop}"
                                    Click="Stop_Click" ToolTip="Stop"/>
                            <Button Style="{StaticResource IpIconButton}" Tag="{StaticResource IconRewind}"
                                    Click="Rewind_Click" ToolTip="Back 10 seconds"/>
                            <Button Style="{StaticResource IpIconButton}" Tag="{StaticResource IconForward}"
                                    Click="Forward_Click" ToolTip="Forward 10 seconds"/>
                            <Button Style="{StaticResource IpIconButton}" Tag="{StaticResource IconPrev}"
                                    Click="PrevClip_Click" ToolTip="Previous clip"/>
                            <Button Style="{StaticResource IpIconButton}" Tag="{StaticResource IconNext}"
                                    Click="NextClip_Click" ToolTip="Next clip"/>
                            <Button Style="{StaticResource IpIconButton}" Tag="{StaticResource IconMarkIn}"
                                    Click="MarkIn_Click" ToolTip="Mark in at the playhead"/>
                            <Button Style="{StaticResource IpIconButton}" Tag="{StaticResource IconMarkOut}"
                                    Click="MarkOut_Click" ToolTip="Mark out at the playhead"/>
                            <Button Style="{StaticResource IpIconButton}" Tag="{StaticResource IconCut}"
                                    Click="ClearMarks_Click" ToolTip="Clear the marks"/>
                            <Button Style="{StaticResource IpIconButton}" Tag="{StaticResource IconInfo}"
                                    Foreground="{StaticResource IpMint}" Click="ToggleInfo_Click"
                                    ToolTip="Show or hide the clip details"/>
                            <Button x:Name="MuteButton" Style="{StaticResource IpIconButton}"
                                    Tag="{StaticResource IconVolume}" Foreground="{StaticResource IpBlue}"
                                    Click="Mute_Click" ToolTip="Mute"/>
                            <Button x:Name="ExpandButton" Style="{StaticResource IpIconButton}"
                                    Tag="{StaticResource IconExpand}" Click="Expand_Click"
                                    ToolTip="Give the picture the whole window"/>
                        </UniformGrid>

                        <!-- Where the clips come from -->
                        <Grid Grid.Row="2" Margin="9,0,9,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IpCrumb}" Tag="{StaticResource IconHome}"
                                        Content="home" Click="OpenStore_Click"
                                        ToolTip="Open the capture store"/>
                                <TextBlock Text="&#x203A;" Foreground="{StaticResource IpDim}" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button x:Name="ParentCrumb" Style="{StaticResource IpCrumb}"
                                        Tag="{StaticResource IconFolder}" Content="..."
                                        Click="OpenStore_Click"/>
                                <TextBlock Text="&#x203A;" Foreground="{StaticResource IpDim}" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button x:Name="StoreCrumb" Style="{StaticResource IpCrumbCurrent}"
                                        Tag="{StaticResource IconFolder}" Content="media"
                                        Click="OpenStore_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource IpIconButton}" Width="22" Height="20"
                                        Foreground="{StaticResource IpMuted}" Tag="{StaticResource IconMonitor}"
                                        Click="OpenStore_Click" ToolTip="Open the store in Explorer"/>
                                <Button Style="{StaticResource IpIconButton}" Width="22" Height="20"
                                        Foreground="{StaticResource IpMuted}" Tag="{StaticResource IconRefresh}"
                                        Click="RefreshClips_Click" ToolTip="Re-read the store"/>
                                <ToggleButton x:Name="StripToggle" Style="{StaticResource IpIconToggle}"
                                              Width="22" Height="20" Tag="{StaticResource IconGrid}"
                                              IsChecked="True" Checked="StripToggle_Changed"
                                              Unchecked="StripToggle_Changed" ToolTip="Show or hide the clip strip"/>
                                <Border Width="1" Height="12" Background="{StaticResource IpLine}" Margin="6,0"/>
                                <ToggleButton x:Name="NotesToggle" Style="{StaticResource IpIconToggle}"
                                              Width="20" Height="20" Tag="{StaticResource IconNotes}"
                                              IsChecked="True" Checked="Notes_Changed" Unchecked="Notes_Changed"/>
                                <TextBlock Text="Notes" Foreground="{StaticResource IpMuted}" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="1,0,2,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Clip strip -->
                        <Grid x:Name="StripHost" Grid.Row="3" Height="226" Margin="9,0,9,9">
                            <ListBox x:Name="ClipStrip" Style="{StaticResource IpClipStrip}"
                                     SelectionChanged="ClipStrip_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="70"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="#070B11" CornerRadius="3,3,0,0"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Path Data="{StaticResource IconFilm}" Fill="#22303F"
                                                          Stretch="Uniform" Width="26" Height="26"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="7,5,7,6">
                                                <TextBlock Text="{Binding Display}" Foreground="{StaticResource IpText}"
                                                           FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding Stamp}" Foreground="{StaticResource IpDim}"
                                                           FontSize="9.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="StripEmpty" Text="the capture store is empty"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource IpDim}" FontSize="11.5"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right handle: collapses the capture deck to widen the stage. -->
                <ToggleButton x:Name="CaptureDeckTab" Grid.Column="2" Content="Capture Deck"
                              Style="{StaticResource IpDeckTab}" HorizontalAlignment="Center"
                              IsChecked="True" Checked="CaptureDeck_Toggled" Unchecked="CaptureDeck_Toggled"/>

                <!-- ======================== capture deck ======================== -->
                <ScrollViewer x:Name="CaptureDeck" Grid.Column="3" Width="352"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Confidence monitor on the receiver being recorded -->
                        <Border Background="{StaticResource IpStage}" BorderBrush="{StaticResource IpTeal}"
                                BorderThickness="1.5" CornerRadius="4" Height="104">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="1"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="PreviewPlaceholder" Text="no signal"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource IpDim}" FontSize="11.5"/>
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="7"
                                        Background="#CC060A10" CornerRadius="3" Padding="7,3">
                                    <TextBlock x:Name="PreviewStatus" Text="starting preview..."
                                               Foreground="{StaticResource IpMuted}" FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Recorder transport -->
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="RecordButton" Grid.Column="0" Click="Record_Click"
                                    Cursor="Hand" Focusable="False"
                                    ToolTip="Start or stop recording the receiver to the store">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="#152A2A" BorderBrush="#1F3B3B"
                                                BorderThickness="1" CornerRadius="3" Height="22">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Ellipse x:Name="dot" Width="7" Height="7" Margin="0,0,7,0"
                                                         Fill="{StaticResource IpRed}"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#1B3535"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="RecordText" Text="Record" FontSize="10.5"
                                           Foreground="{StaticResource IpText}"/>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button x:Name="PauseRecordButton" Style="{StaticResource IpIconButton}"
                                        Width="46" Height="22" Tag="{StaticResource IconPause}"
                                        Foreground="{StaticResource IpMuted}" IsEnabled="False"
                                        ToolTip="The recorder writes continuous segments and cannot pause"/>
                                <Button x:Name="StopRecordButton" Style="{StaticResource IpIconButton}"
                                        Width="46" Height="22" Tag="{StaticResource IconStop}"
                                        Foreground="{StaticResource IpMuted}" Click="StopRecord_Click"
                                        ToolTip="Stop recording"/>
                                <Button Style="{StaticResource IpIconButton}" Width="46" Height="22"
                                        Tag="{StaticResource IconCamera}" Foreground="{StaticResource IpMuted}"
                                        Click="Snapshot_Click" ToolTip="Save the current preview frame to the store"/>
                                <Button Style="{StaticResource IpIconButton}" Width="46" Height="22"
                                        Tag="{StaticResource IconGear}" Foreground="{StaticResource IpMuted}"
                                        Click="SourceDeck_Click" ToolTip="Boards and modules"/>
                            </StackPanel>
                        </Grid>

                        <!-- Audio tracks -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,6,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Path Data="{StaticResource IconForward}" Fill="{StaticResource IpMuted}"
                                          Stretch="Uniform" Width="9" Height="9" Margin="0,0,7,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Audio Tracks" Style="{StaticResource IpCardTitle}"/>
                                </StackPanel>

                                <!-- Group 1, channels 1-2 is what the recorder muxes; the rest of
                                     the pairs are listed so the layout matches the desk, and are
                                     disabled rather than pretending to switch. -->
                                <Grid x:Name="AudioTrackRows">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Row="0" Grid.Column="0" Content="Stereo 1"
                                                 Style="{StaticResource IpTrackRadio}" IsChecked="True"
                                                 GroupName="AudioPair"
                                                 ToolTip="Group 1, channels 1-2 - what the recorder muxes"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <Grid Height="7" Margin="0,0,0,2">
                                            <Border Background="#16202C" CornerRadius="2"/>
                                            <Border Background="{StaticResource IpMeterFill}" CornerRadius="2"
                                                    HorizontalAlignment="Left" Width="196"/>
                                            <TextBlock Text="3 dB" FontSize="7" Foreground="#06120E"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="7">
                                            <Border Background="#16202C" CornerRadius="2"/>
                                            <Border Background="{StaticResource IpMeterFill}" CornerRadius="2"
                                                    HorizontalAlignment="Left" Width="196"/>
                                            <TextBlock Text="3 dB" FontSize="7" Foreground="#06120E"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <RadioButton Grid.Row="1" Grid.Column="0" Content="Stereo 2"
                                                 Style="{StaticResource IpTrackRadio}" IsEnabled="False"
                                                 GroupName="AudioPair" Margin="0,3,0,0"
                                                 ToolTip="Emerald records group 1, channels 1-2"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,3,0,0">
                                        <Grid Height="7" Margin="0,0,0,2">
                                            <Border Background="#16202C" CornerRadius="2"/>
                                            <TextBlock Text="3 dB" FontSize="7" Foreground="#4A5765"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="7">
                                            <Border Background="#16202C" CornerRadius="2"/>
                                            <TextBlock Text="3 dB" FontSize="7" Foreground="#4A5765"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <RadioButton Grid.Row="2" Grid.Column="0" Content="Stereo 3"
                                                 Style="{StaticResource IpTrackRadio}" IsEnabled="False"
                                                 GroupName="AudioPair" Margin="0,3,0,0"
                                                 ToolTip="Emerald records group 1, channels 1-2"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,3,0,0">
                                        <Grid Height="7" Margin="0,0,0,2">
                                            <Border Background="#16202C" CornerRadius="2"/>
                                            <TextBlock Text="3 dB" FontSize="7" Foreground="#4A5765"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="7">
                                            <Border Background="#16202C" CornerRadius="2"/>
                                            <TextBlock Text="3 dB" FontSize="7" Foreground="#4A5765"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <RadioButton Grid.Row="3" Grid.Column="0" Content="Stereo 4"
                                                 Style="{StaticResource IpTrackRadio}" IsEnabled="False"
                                                 GroupName="AudioPair" Margin="0,3,0,0"
                                                 ToolTip="Emerald records group 1, channels 1-2"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,3,0,0">
                                        <Grid Height="7" Margin="0,0,0,2">
                                            <Border Background="#16202C" CornerRadius="2"/>
                                            <TextBlock Text="3 dB" FontSize="7" Foreground="#4A5765"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Height="7">
                                            <Border Background="#16202C" CornerRadius="2"/>
                                            <TextBlock Text="3 dB" FontSize="7" Foreground="#4A5765"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- What is arriving -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,6,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Path Data="{StaticResource IconInfo}" Fill="{StaticResource IpMuted}"
                                          Stretch="Uniform" Width="10" Height="10" Margin="0,0,7,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Source Details" Style="{StaticResource IpCardTitle}"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="URL/path"
                                               Style="{StaticResource IpLabel}"/>
                                    <TextBlock x:Name="SourceUrlText" Grid.Row="0" Grid.Column="1" Text="-"
                                               Style="{StaticResource IpValue}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Title"
                                               Style="{StaticResource IpLabel}" Margin="0,4,8,0"/>
                                    <TextBlock x:Name="SourceTitleText" Grid.Row="1" Grid.Column="1" Text="-"
                                               Style="{StaticResource IpValue}" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Description"
                                               Style="{StaticResource IpLabel}" Margin="0,4,8,0"/>
                                    <TextBlock x:Name="SourceDescriptionText" Grid.Row="2" Grid.Column="1"
                                               Text="-" Style="{StaticResource IpValue}" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration | FPS"
                                               Style="{StaticResource IpLabel}" Margin="0,4,8,0"/>
                                    <TextBlock x:Name="SourceDurationText" Grid.Row="3" Grid.Column="1" Text="-"
                                               Style="{StaticResource IpValue}" Margin="0,4,0,0"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Format"
                                               Style="{StaticResource IpLabel}" Margin="0,4,8,0"/>
                                    <TextBlock x:Name="SourceFormatText" Grid.Row="4" Grid.Column="1"
                                               Text="-" Style="{StaticResource IpValue}" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- How the next recording is made. Every field here reaches the
                             recorder: the receiver it opens, and the command it encodes with. -->
                        <Border Style="{StaticResource IpCardBorder}" Margin="0,6,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Path Data="{StaticResource IconGear}" Fill="{StaticResource IpMuted}"
                                          Stretch="Uniform" Width="10" Height="10" Margin="0,0,7,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Recording Configuration" Style="{StaticResource IpCardTitle}"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Board"
                                               Style="{StaticResource IpLabel}"/>
                                    <ComboBox x:Name="BoardBox" Grid.Row="0" Grid.Column="1"
                                              Style="{StaticResource IpMiniCombo}" Tag="no boards found"
                                              SelectionChanged="BoardBox_SelectionChanged"
                                              ToolTip="DELTACAST board the receiver is on"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="RX Port"
                                               Style="{StaticResource IpLabel}" Margin="0,3,8,0"/>
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="PortBox" Grid.Column="0"
                                                  Style="{StaticResource IpMiniCombo}" Tag="-"
                                                  SelectionChanged="PortBox_SelectionChanged"
                                                  ToolTip="Receiver this deck previews and records"/>
                                        <Button x:Name="RefreshButton" Grid.Column="2"
                                                Style="{StaticResource IpIconButton}" Width="24" Height="18"
                                                Tag="{StaticResource IconRefresh}"
                                                Foreground="{StaticResource IpMuted}" Click="Refresh_Click"
                                                ToolTip="Rescan the boards"/>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Output path"
                                               Style="{StaticResource IpLabel}" Margin="0,3,8,0"/>
                                    <TextBox x:Name="OutputPathBox" Grid.Row="2" Grid.Column="1"
                                             Style="{StaticResource IpMiniTextBox}" Margin="0,3,0,0"
                                             LostFocus="OutputPath_LostFocus"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Title"
                                               Style="{StaticResource IpLabel}" Margin="0,3,8,0"/>
                                    <TextBox x:Name="RecordTitleBox" Grid.Row="3" Grid.Column="1"
                                             Style="{StaticResource IpMiniTextBox}" Margin="0,3,0,0"
                                             IsReadOnly="True" Foreground="{StaticResource IpDim}"
                                             ToolTip="Names the files a recording writes"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Description"
                                               Style="{StaticResource IpLabel}" Margin="0,3,8,0"
                                               VerticalAlignment="Top"/>
                                    <TextBox x:Name="RecordDescriptionBox" Grid.Row="4" Grid.Column="1"
                                             Style="{StaticResource IpMiniTextBox}" Margin="0,3,0,0"
                                             Height="26" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalContentAlignment="Top" IsReadOnly="True"
                                             Foreground="{StaticResource IpDim}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Set Duration"
                                               Style="{StaticResource IpLabel}" Margin="0,3,8,0"/>
                                    <TextBox x:Name="SetDurationBox" Grid.Row="5" Grid.Column="1"
                                             Style="{StaticResource IpMiniTextBox}" Margin="0,3,0,0"
                                             Width="96" HorizontalAlignment="Left" FontFamily="Consolas"
                                             core:TimecodeMask.Enabled="True"
                                             ToolTip="Stop the recording after this long. Empty records until stopped."/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="FPS"
                                               Style="{StaticResource IpLabel}" Margin="0,3,8,0"/>
                                    <ComboBox x:Name="FpsCombo" Grid.Row="6" Grid.Column="1"
                                              Style="{StaticResource IpMiniCombo}" Margin="0,3,0,0"
                                              Width="96" HorizontalAlignment="Left"
                                              SelectionChanged="Profile_Changed"
                                              ToolTip="Used when the receiver reports no standard of its own"/>

                                    <!-- Every recording writes both of these, from the one pass
                                         over the receiver. Fixed formats, so they are shown
                                         rather than offered. -->
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Low res"
                                               Style="{StaticResource IpLabel}" Margin="0,3,8,0"/>
                                    <Grid Grid.Row="7" Grid.Column="1" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource IpReadOnlyField}">
                                            <TextBlock Text="MP4" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{StaticResource IpDim}"/>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource IpReadOnlyField}">
                                            <TextBlock Text="H.264" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{StaticResource IpDim}"/>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource IpReadOnlyField}">
                                            <TextBlock Text="AAC" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{StaticResource IpDim}"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="High res"
                                               Style="{StaticResource IpLabel}" Margin="0,3,8,0"/>
                                    <Grid Grid.Row="8" Grid.Column="1" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource IpReadOnlyField}">
                                            <TextBlock Text="MOV" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{StaticResource IpDim}"/>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource IpReadOnlyField}">
                                            <TextBlock Text="ProRes 422" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{StaticResource IpDim}"/>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource IpReadOnlyField}">
                                            <TextBlock Text="AAC" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{StaticResource IpDim}"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Video Bitrate"
                                               Style="{StaticResource IpLabel}" Margin="0,3,8,0"/>
                                    <ComboBox x:Name="VideoBitrateCombo" Grid.Row="9" Grid.Column="1"
                                              Style="{StaticResource IpMiniCombo}" Margin="0,3,0,0"
                                              Width="126" HorizontalAlignment="Left"
                                              SelectionChanged="Profile_Changed"
                                              ToolTip="The low res proxy. Auto detect leaves rate control to the encoder; the ProRes master is quality-driven."/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Audio Bitrate"
                                               Style="{StaticResource IpLabel}" Margin="0,3,8,0"/>
                                    <ComboBox x:Name="AudioBitrateCombo" Grid.Row="10" Grid.Column="1"
                                              Style="{StaticResource IpMiniCombo}" Margin="0,3,0,0"
                                              Width="126" HorizontalAlignment="Left"
                                              SelectionChanged="Profile_Changed"/>

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Audio Sample&#x0a;Frequency"
                                               Style="{StaticResource IpLabel}" Margin="0,3,8,0"
                                               VerticalAlignment="Top"/>
                                    <ComboBox x:Name="SampleRateCombo" Grid.Row="11" Grid.Column="1"
                                              Style="{StaticResource IpMiniCombo}" Margin="0,3,0,0"
                                              Width="126" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              SelectionChanged="Profile_Changed"
                                              ToolTip="SDI audio arrives at 48 kHz; anything else is resampled"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ProfileNote" Foreground="{StaticResource IpDim}" FontSize="9.5"
                                   Margin="2,5,2,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================== source drawer ======================= -->
                <!-- The boards as the SDK sees them, and the way through to the other
                     modules. It sits over the stage rather than in it, so opening it costs
                     the picture nothing. -->
                <Border x:Name="SourceDrawer" Grid.Column="1" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Width="330"
                        Margin="10,10,0,0" Background="#F2101823" BorderBrush="{StaticResource IpLine}"
                        BorderThickness="1" CornerRadius="5" Padding="13">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="Boards and modules" Style="{StaticResource IpCardTitle}"/>
                            <Button Style="{StaticResource IpIconButton}" Width="18" Height="18"
                                    HorizontalAlignment="Right" Foreground="{StaticResource IpMuted}"
                                    Tag="{StaticResource IconClose}" Click="CloseSourceDeck_Click"/>
                        </Grid>

                        <TextBlock x:Name="ApiVersionText" Text="scanning boards..."
                                   Foreground="{StaticResource IpMuted}" FontSize="10.5" TextWrapping="Wrap"/>

                        <TextBlock x:Name="BoardDetailText" Text="-" Foreground="{StaticResource IpDim}"
                                   FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <TextBlock x:Name="ClockStatusText" Text="timecode: idle"
                                   Foreground="{StaticResource IpDim}" FontSize="10" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- The generator's address, shared with the EDL and the Ingest
                             Controller: set it in any of the three and all three follow. -->
                        <TextBlock Text="Timecode generator" Foreground="{StaticResource IpMuted}"
                                   FontSize="10" Margin="0,10,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ApiUrlBox" Grid.Column="0" Height="26" FontSize="11"
                                     Padding="6,0"/>
                            <Button Grid.Column="1" Content="Apply" Style="{StaticResource GhostButton}"
                                    Height="26" FontSize="11" Padding="10,0" Margin="6,0,0,0"
                                    Click="ApplyApi_Click"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Rescan" Style="{StaticResource GhostButton}"
                                    Height="26" FontSize="11" Padding="0" Click="Refresh_Click"/>
                            <Button Grid.Column="2" Content="EDL" Style="{StaticResource GhostButton}"
                                    Height="26" FontSize="11" Padding="0" Click="Logging_Click"/>
                            <Button Grid.Column="4" Content="Live Edit" Style="{StaticResource GhostButton}"
                                    Height="26" FontSize="11" Padding="0" Click="Playback_Click"/>
                        </Grid>

                        <Button Content="Ingest Controller" Style="{StaticResource GhostButton}"
                                Height="26" FontSize="11" Padding="0" Margin="0,6,0,0"
                                Click="Ingest_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Window>

<Window x:Class="Emerald.App.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor" Height="1010" Width="1180" MinHeight="760" MinWidth="1000"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================================================== the plant, right now -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="MONITOR" Foreground="{StaticResource Text}"
                               FontSize="15" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TcDisplay" Text="--:--:--:--" FontFamily="Consolas"
                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource Tc}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecordText" Style="{StaticResource Hint}" Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- The chain, left to right, in the order the pictures travel. Each segment is
                     live from PipelineState and TidalLock rather than reconstructed from the
                     log, so it cannot be left behind by a line that went missing. -->
                <UniformGrid Grid.Row="1" Rows="1" Columns="5">
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <TextBlock Text="CAPTURE" Style="{StaticResource StageLabel}"/>
                            <TextBlock x:Name="CaptureHeadline" Style="{StaticResource StageHeadline}"/>
                            <TextBlock x:Name="CaptureDetail" Style="{StaticResource StageDetail}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <TextBlock Text="TIDAL LOCK" Style="{StaticResource StageLabel}"/>
                            <TextBlock x:Name="DelayHeadline" Style="{StaticResource StageHeadline}"/>
                            <TextBlock x:Name="DelayDetail" Style="{StaticResource StageDetail}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <TextBlock Text="EDL QUEUE" Style="{StaticResource StageLabel}"/>
                            <TextBlock x:Name="EdlHeadline" Style="{StaticResource StageHeadline}"/>
                            <TextBlock x:Name="EdlDetail" Style="{StaticResource StageDetail}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <TextBlock Text="ON AIR" Style="{StaticResource StageLabel}"/>
                            <TextBlock x:Name="AirHeadline" Style="{StaticResource StageHeadline}"/>
                            <TextBlock x:Name="AirDetail" Style="{StaticResource StageDetail}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <TextBlock Text="INGEST" Style="{StaticResource StageLabel}"/>
                            <TextBlock x:Name="IngestHeadline" Style="{StaticResource StageHeadline}"/>
                            <TextBlock x:Name="IngestDetail" Style="{StaticResource StageDetail}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ==================================================== filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Source" Style="{StaticResource FieldLabel}" Margin="0,0,7,0"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="SourceCombo" Width="120" SelectionChanged="Filter_Changed"/>

                    <TextBlock Text="Level" Style="{StaticResource FieldLabel}" Margin="14,0,7,0"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="LevelCombo" Width="90" SelectionChanged="Filter_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="230" TextChanged="Filter_Changed"
                             ToolTip="Match on the message, the file or the id"/>
                    <TextBox x:Name="IdBox" Width="110" Margin="8,0,0,0" TextChanged="Filter_Changed"
                             ToolTip="Follow one recording, ingest or EDL command by its id"/>
                    <Button Content="All" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Height="26" Padding="10,0" Click="ClearFilters_Click"
                            ToolTip="Clear every filter"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="FollowToggle" Content="FOLLOW" IsChecked="True"
                                  Style="{StaticResource IpDeckTab}" Height="26" Padding="12,0"
                                  FontSize="11"
                                  ToolTip="Keep the newest line in view. Turns itself off when you scroll back."/>
                    <Button Content="Export" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Height="26" Padding="12,0" Click="Export_Click"
                            ToolTip="Save what is shown"/>
                    <Button Content="Open folder" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Height="26" Padding="12,0" Click="OpenFolder_Click"
                            ToolTip="Open the folder the record is written to"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================== the record -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,10,14,8">
                    <TextBlock x:Name="CountText" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <TextBlock x:Name="FolderText" Style="{StaticResource Hint}"
                               HorizontalAlignment="Right" Margin="0"/>
                </Grid>

                <!-- A virtualizing ListView rather than the ItemsControl-in-a-ScrollViewer the
                     other panels use: this holds thousands of rows, and that arrangement
                     realizes every one of them. -->
                <ListView x:Name="LogList" Grid.Row="1" Margin="6,0,6,6"
                          Background="Transparent" BorderThickness="0"
                          SelectionMode="Single"
                          MouseDoubleClick="LogList_DoubleClick"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Time" Width="86"
                                            DisplayMemberBinding="{Binding Time}"/>
                            <GridViewColumn Header="Timecode" Width="96"
                                            DisplayMemberBinding="{Binding Timecode}"/>
                            <GridViewColumn Header="Source" Width="82"
                                            DisplayMemberBinding="{Binding Source}"/>
                            <GridViewColumn Header="Id" Width="80"
                                            DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="File" Width="170"
                                            DisplayMemberBinding="{Binding File}"/>
                            <GridViewColumn Header="Message" Width="560">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" FontFamily="Consolas"
                                                   FontSize="11.5" Foreground="{Binding Accent}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="Emerald.LiveEdit.AudioTrackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Play audio" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Grid.Row="0" Foreground="{StaticResource Ok}"
                   FontSize="14" FontWeight="Bold"/>

        <!-- Straight away. Its own button rather than a choice and an OK, because it is the one
             that is wanted in a hurry. -->
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <Button Content="Play instantly" Style="{StaticResource PrimaryButton}" Height="34"
                    Click="Now_Click"/>
            <TextBlock x:Name="NowText" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}"/>
        </StackPanel>

        <!-- At the mark in, when there is one air has not reached. Shown disabled otherwise, with why,
             so it is known to be there. -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="MarkButton" Content="Play on mark in" Style="{StaticResource GhostButton}"
                    Height="34" Click="Mark_Click"/>
            <TextBlock x:Name="MarkText" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TimecodeBox" Height="34" FontSize="15" Padding="9,0"
                         FontFamily="Consolas" VerticalContentAlignment="Center"
                         ToolTip="HH:MM:SS:FF on this timeline"/>
                <Button Grid.Column="1" Content="Play from timecode" IsDefault="True"
                        Style="{StaticResource GhostButton}" Height="34" Padding="14,0"
                        Margin="8,0,0,0" Click="At_Click"/>
            </Grid>
            <TextBlock Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}"
                       Text="It plays from there until the next audio change on the timeline. A timecode that has not been recorded yet is fine."/>
        </StackPanel>

        <TextBlock x:Name="ProblemText" Grid.Row="4" Margin="0,10,0,0" FontSize="11"
                   Foreground="{StaticResource Bad}" TextWrapping="Wrap" Visibility="Collapsed"/>

        <Button Grid.Row="5" Content="Cancel" Style="{StaticResource GhostButton}" Width="88"
                Height="30" Margin="0,16,0,0" HorizontalAlignment="Right" IsCancel="True"/>
    </Grid>
</Window>

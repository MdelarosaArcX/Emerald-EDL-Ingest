<Window x:Class="Emerald.LiveEdit.BookmarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bookmarks" Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="BOOKMARKS" Foreground="{StaticResource Warn}"
                   FontSize="14" FontWeight="Bold"/>

        <TextBlock x:Name="DayText" Grid.Row="1" Margin="0,6,0,0" FontSize="11"
                   Foreground="{StaticResource Muted}"/>

        <!-- Every bookmark of the day, in order. The timecode carries frames because a censor
             point is decided on a frame, not on a second. -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="#101419"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
            <Grid>
                <ListView x:Name="MarkList" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource Text}" FontSize="12"
                          SelectionChanged="Mark_Selected"
                          MouseDoubleClick="Mark_DoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Timecode" Width="130"
                                            DisplayMemberBinding="{Binding Timecode}"/>
                            <GridViewColumn Header="Frame" Width="100"
                                            DisplayMemberBinding="{Binding Frame}"/>
                            <GridViewColumn Header="Name" Width="270"
                                            DisplayMemberBinding="{Binding Name}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock x:Name="EmptyText" Margin="16" VerticalAlignment="Top"
                           Foreground="{StaticResource Muted}" FontSize="11.5"
                           TextWrapping="Wrap"
                           Text="No bookmarks on this day yet. Type a name and a timecode below and press Add."/>
            </Grid>
        </Border>

        <!-- Adding and amending. One set of fields for both: select a row to load it, change it
             and press Update, or leave nothing selected and press Add. -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Name" Foreground="{StaticResource Muted}" FontSize="10.5"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Height="30" FontSize="12.5" Padding="9,0"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Width="150">
                <TextBlock Text="Timecode" Foreground="{StaticResource Muted}" FontSize="10.5"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TimecodeBox" Height="30" FontSize="12.5" Padding="9,0"
                         FontFamily="Consolas" VerticalContentAlignment="Center"
                         ToolTip="HH:MM:SS:FF, or a frame number. Frames are exact."/>
            </StackPanel>

            <TextBlock x:Name="ProblemText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                       FontSize="11" Foreground="{StaticResource Bad}" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="AddButton" Content="Add" Style="{StaticResource PrimaryButton}"
                    Width="92" Height="30" Click="Add_Click"
                    ToolTip="Add a bookmark at the timecode above"/>
            <Button x:Name="UpdateButton" Content="Update" Style="{StaticResource GhostButton}"
                    Width="92" Height="30" Margin="8,0,0,0" IsEnabled="False"
                    Click="Update_Click"/>
            <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource GhostButton}"
                    Width="92" Height="30" Margin="8,0,0,0" IsEnabled="False"
                    Click="Delete_Click"/>
            <Button x:Name="GoToButton" Content="Go to" Style="{StaticResource GhostButton}"
                    Width="92" Height="30" Margin="8,0,0,0" IsEnabled="False"
                    Click="GoTo_Click" ToolTip="Close and put the playhead on this bookmark"/>

            <Button Content="Close" Style="{StaticResource GhostButton}" Width="92" Height="30"
                    Margin="8,0,0,0" HorizontalAlignment="Right" IsCancel="True"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Emerald.LiveEdit</RootNamespace>
    <AssemblyName>Emerald.LiveEdit</AssemblyName>
    <!-- VideoMasterHD.dll in System32 is 64-bit, so every assembly in the process must be. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Emerald.Core\Emerald.Core.csproj" />
    <ProjectReference Include="..\Emerald.Media\Emerald.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same logo the capture deck shows while its screen has no picture. -->
    <Resource Include="..\..\assets\logo\Emerald_Logo@512w.png" Link="Assets\emerald-logo.png" />
  </ItemGroup>
</Project>

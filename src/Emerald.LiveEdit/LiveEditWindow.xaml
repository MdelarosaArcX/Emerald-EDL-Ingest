<Window x:Class="Emerald.LiveEdit.LiveEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emerald - Live Edit" Height="820" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="190"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="LIVE EDIT" Foreground="{StaticResource Ok}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="layout only - trimming and rendering are not built yet"
                       Margin="14,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Warn}" FontSize="11.5"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelDeep}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="1"/>
                <TextBlock x:Name="PreviewPlaceholder" Text="select a clip"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" FontSize="14"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,14,14,10">
                    <TextBlock Text="CAPTURED MEDIA" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right" Height="22" FontSize="10.5" Padding="9,0"
                            Click="Refresh_Click"/>
                </Grid>

                <TextBlock x:Name="StoreText" DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
                           Margin="14,8,14,14"/>

                <ListBox x:Name="ClipList" Background="Transparent" BorderThickness="0"
                         Margin="6,0,6,0" Foreground="{StaticResource Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ClipList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="#1F242D" CornerRadius="4"
                                                Padding="10,8" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#262D38"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush"
                                                        Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0">
                                    <Run Text="{Binding DurationText, Mode=OneWay}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding FormatText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0" Padding="14,10"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="&#9668;&#9668;" Style="{StaticResource GhostButton}" Width="46" IsEnabled="False"/>
                    <Button Content="&#9654;" Style="{StaticResource GhostButton}" Width="46" Margin="8,0" IsEnabled="False"/>
                    <Button Content="&#9658;&#9658;" Style="{StaticResource GhostButton}" Width="46" IsEnabled="False"/>
                    <Button Content="Mark In" Style="{StaticResource GhostButton}" Margin="20,0,8,0" IsEnabled="False"/>
                    <Button Content="Mark Out" Style="{StaticResource GhostButton}" IsEnabled="False"/>
                </StackPanel>

                <TextBlock x:Name="PositionText" Text="00:00:00:00" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="15"
                           Foreground="{StaticResource Tc}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0"
                Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Canvas x:Name="RulerCanvas" Grid.Row="0" ClipToBounds="True"
                        Background="#141920" SizeChanged="Timeline_SizeChanged"/>

                <Canvas x:Name="TrackCanvas" Grid.Row="1" ClipToBounds="True"
                        SizeChanged="Timeline_SizeChanged"/>

                <Rectangle x:Name="Playhead" Grid.RowSpan="2" Width="1.5" HorizontalAlignment="Left"
                           Fill="{StaticResource Bad}" Margin="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>

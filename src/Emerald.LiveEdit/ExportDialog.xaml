<Window x:Class="Emerald.LiveEdit.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export marked range" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="EXPORT" Foreground="{StaticResource Ok}"
                   FontSize="14" FontWeight="Bold"/>

        <!-- What is actually going to be written. An operator should not have to trust the
             marks they set two minutes ago. -->
        <TextBlock x:Name="RangeText" Grid.Row="1" Margin="0,8,0,0"
                   FontFamily="Consolas" FontSize="11.5"
                   Foreground="{StaticResource Tc}" TextWrapping="Wrap"/>

        <TextBlock x:Name="PartsText" Grid.Row="2" Margin="0,4,0,0"
                   FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Name" Foreground="{StaticResource Muted}" FontSize="10.5"
                       FontWeight="SemiBold" Margin="0,0,0,4"/>
            <!-- Padding="9,0" and not the style's "9,6", which is the whole bug this fixes.
                 The shared TextBox template puts its content host inside that padding, so a
                 28-high box with 6 above and below left 14 pixels for a 12pt line - the text was
                 there and clipped entirely out of sight. The metadata box below was fine because
                 it is 96 high and had room to spare. Height raised too, so a descender fits. -->
            <TextBox x:Name="NameBox" Height="32" FontSize="12.5" Padding="9,0"
                     VerticalContentAlignment="Center"/>
            <TextBlock x:Name="NameHint" Margin="0,4,0,0" FontSize="10.5"
                       Foreground="{StaticResource Muted}"
                       Text="The extension is added for you."/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Metadata" Foreground="{StaticResource Muted}" FontSize="10.5"
                       FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="MetadataBox" Height="96" FontSize="12"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"/>
            <TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap"
                       Text="Written to a .json file beside the media, so it can be corrected later without rewriting the video."/>
        </StackPanel>

        <TextBlock x:Name="ProblemText" Grid.Row="5" Margin="0,10,0,0" FontSize="11"
                   Foreground="{StaticResource Bad}" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Width="88"
                    Height="30" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="ExportButton" Content="Export" Style="{StaticResource PrimaryButton}"
                    Width="110" Height="30" Margin="8,0,0,0" IsDefault="True"
                    Click="Export_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Emerald-Setup.exe: the installer as one file with a window. See Program.cs.

    .NET Framework 4.8, not .NET 8, and on purpose: it has to run on a machine with nothing on
    it yet, and 4.8 is part of every Windows 10 and 11. Emerald itself brings .NET 8 inside its
    payload; the setup cannot, because it is what unpacks the payload. Built against the
    framework Windows already has (FrameworkPathOverride), so it needs no targeting pack and
    nothing from the internet.

    x64, also on purpose. A 32-bit setup is sent to SysWOW64 when it writes System32 and to
    Program Files (x86) when it writes Program Files - and so is every cmd and PowerShell it
    starts - which would put the DELTACAST library and Emerald where Emerald never looks.

    Not in Emerald.sln: publish.bat builds it, and nothing else depends on it.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Emerald-Setup</AssemblyName>
    <RootNamespace>Emerald.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\src\Emerald.App\emerald.ico</ApplicationIcon>
    <FrameworkPathOverride>$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Product>Emerald</Product>
    <Company>Peregrine Broadcast</Company>
    <Description>Emerald setup</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Management" />
  </ItemGroup>
</Project>
